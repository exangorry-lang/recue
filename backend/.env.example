# Copy these values into your system environment or deployment secret store.
DB_URL=jdbc:mysql://localhost:3306/rescue_training?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=replace-with-db-user
DB_PASSWORD=replace-with-strong-password
# Use at least 32 random bytes, and never commit the real production value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Used only by initial seed accounts whose password is __CHANGE_ME_BCRYPT__.
INITIAL_USER_PASSWORD=replace-with-a-strong-initial-password
